{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.json",
  "title": "ReelEstate project.json common fields",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "category",
    "title",
    "property",
    "price",
    "agency",
    "agent",
    "drawbacks",
    "narration"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$"
    },
    "category": {
      "enum": [
        "rental",
        "resale",
        "new-home"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "is_example": {
      "type": "boolean"
    },
    "ai_voice": {
      "type": "boolean"
    },
    "ad_disclosure": {
      "type": "boolean"
    },
    "export": {
      "type": "object",
      "properties": {
        "default_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "ratios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ratio"
          }
        },
        "fps": {
          "enum": [
            24,
            25,
            30,
            60
          ]
        }
      }
    },
    "property": {
      "type": "object",
      "required": [
        "property_type",
        "area",
        "location"
      ],
      "properties": {
        "property_type": {
          "type": "string",
          "minLength": 2
        },
        "layout": {
          "type": "string"
        },
        "area": {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "enum": [
                "建筑面积",
                "套内建筑面积"
              ]
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "location": {
          "type": "object",
          "required": [
            "city",
            "district"
          ],
          "properties": {
            "city": {
              "type": "string",
              "minLength": 2
            },
            "district": {
              "type": "string",
              "minLength": 2
            },
            "street": {
              "type": "string"
            },
            "community": {
              "type": "string"
            }
          }
        }
      }
    },
    "price": {
      "type": "object",
      "required": [
        "type",
        "value",
        "unit",
        "valid_until"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 2
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "valid_until": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "agency": {
      "type": "object",
      "required": [
        "full_name"
      ],
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 6,
          "pattern": "公司$"
        },
        "record_no": {
          "type": "string"
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "name",
        "certified_on_camera"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "certified_on_camera": {
          "type": "boolean"
        }
      }
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drawbacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "nearby": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "distance_m": {
            "type": "number",
            "minimum": 0
          },
          "basis": {
            "type": "string"
          },
          "status": {
            "enum": [
              "已建成",
              "在建",
              "规划中"
            ]
          }
        }
      }
    },
    "tts": {
      "type": "object",
      "properties": {
        "voice": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "voicedesign",
            "customvoice",
            "clone",
            "edge",
            "own"
          ]
        }
      }
    },
    "narration": {
      "type": "object",
      "required": [
        "segments"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      }
    },
    "style": {
      "enum": [
        "mediastorm"
      ]
    }
  },
  "$defs": {
    "ratio": {
      "enum": [
        "4x3",
        "3x4",
        "9x16"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "segment": {
      "type": "object",
      "required": [
        "id",
        "text",
        "presenter"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "presenter": {
          "enum": [
            "fullscreen",
            "pip-left",
            "pip-right"
          ]
        },
        "presenter_clip": {
          "type": "string"
        },
        "clip_start": {
          "type": "number",
          "minimum": 0
        },
        "broll": {
          "type": "string"
        },
        "visual_label": {
          "type": "string"
        },
        "card": {
          "type": "object",
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}

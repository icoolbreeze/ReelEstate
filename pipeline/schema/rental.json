{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rental.json",
  "title": "Rental (租赁) project",
  "allOf": [{"$ref": "common.json"}],
  "type": "object",
  "required": ["rental"],
  "properties": {
    "category": {"const": "rental"},
    "price": {
      "type": "object",
      "properties": {
        "type": {"const": "月租金"},
        "unit": {"const": "元/月"}
      }
    },
    "rental": {
      "type": "object",
      "required": ["rent_type", "payment_terms"],
      "properties": {
        "rent_type": {"enum": ["整租", "合租"]},
        "room_desc": {"type": "string"},
        "payment_terms": {"type": "string", "minLength": 2},
        "service_fee": {"type": "string"},
        "utilities": {"type": "string"},
        "available_from": {"type": "string"},
        "min_lease_months": {"type": "integer", "minimum": 0}
      }
    }
  }
}

# ---- 依赖 / 构建 ----
node_modules/
build/
dist/
out/
.remotion/
remotion/.cache/

# ---- 环境变量（真实路径/密钥，不提交）----
.env
.env.local

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---- 渲染输出（任意位置的 output/ 目录）----
output/

# ---- 房源项目：私有素材，默认全部忽略 ----
# 只保留 _example 示例项目和各分类目录的 .gitkeep
/projects/*
!/projects/_example/
!/projects/rental/
!/projects/resale/
!/projects/new-home/
/projects/rental/*
!/projects/rental/.gitkeep
/projects/resale/*
!/projects/resale/.gitkeep
/projects/new-home/*
!/projects/new-home/.gitkeep
# 即使在 _example 里，也不提交音视频
/projects/**/*.wav
/projects/**/*.mp3
/projects/**/*.mp4
/projects/**/*.mov
/projects/**/*.m4a

# ---- 声音克隆参考音频（私有，需本人书面授权）----
/voices/clone/*
!/voices/clone/.gitkeep
!/voices/clone/README.md

# ---- qwentts.cpp 构建产物（子模块自身 .gitignore 也忽略 build/）----
/vendor/qwentts.cpp/build/
/vendor/qwentts.cpp/models/*.gguf

# ---- 系统杂项 ----
.DS_Store
Thumbs.db
desktop.ini
*.log

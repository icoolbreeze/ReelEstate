# ---- 依赖 / 构建 ----
node_modules/
build/
dist/
out/
.remotion/
remotion/.cache/

# ---- 环境变量（真实路径/密钥，不提交）----
.env
.env.local

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---- 渲染输出（任意位置的 output/ 目录）----
output/

# ---- 视频期：私有素材，全部忽略（projects/listing|knowledge|interview）----
/projects/*

# ---- 声音克隆参考音频（私有，需本人书面授权）----
/voices/clone/*
!/voices/clone/.gitkeep
!/voices/clone/README.md

# ---- qwentts.cpp 构建产物（子模块自身 .gitignore 也忽略 build/）----
/vendor/qwentts.cpp/build/
/vendor/qwentts.cpp/models/*.gguf

# ---- 第三方 skill 参考克隆（本地使用，不入库）----
/vendor/video-shotcraft/
/vendor/video-talkcraft/

# ---- 系统杂项 ----
.DS_Store
Thumbs.db
desktop.ini
*.log

# ---- 本地素材库：媒体文件不入库，只提交说明与来源清单 ----
/assets/warehouse/**
!/assets/warehouse/
!/assets/warehouse/README.md
!/assets/warehouse/SOURCES.json

# ---- CosyVoice (voice clone; repo + venv + models, local only) ----
/vendor/cosyvoice/
/vendor/f5tts/
/vendor/rvm/
/vendor/matanyone2/
/vendor/indextts2/

# ---- listing 房源 (templates/map-hub; episodes in projects/listing stay local) ----
/templates/map-hub/remotion/public
/templates/map-hub/remotion/src/episode
/templates/map-hub/remotion/.current-episode
/templates/map-hub/shared/public/fonts/
!/projects/listing/
/projects/listing/*
!/projects/listing/README.md

# ---- knowledge 口播 series (docs/RUNBOOK-knowledge-koubo.md; episodes stay local) ----
/templates/knowledge/remotion/public
/templates/knowledge/remotion/src/episode
!/projects/knowledge/
/projects/knowledge/*
!/projects/knowledge/README.md

# ---- interview / 小ONE会客厅 (docs/RUNBOOK-interview.md; episodes stay local) ----
/templates/interview/remotion/public
/templates/interview/remotion/src/episode
!/projects/interview/
/projects/interview/*
!/projects/interview/README.md

# ---- shared presenter profiles (yaml tracked, media local) ----
/assets/presenter/*/media/

# ---- local MCP/generation artifacts ----
/.playwright-mcp/
/.wav
/flova-images/
*.bak

jobs/agent/


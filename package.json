{
  "name": "reelestate",
  "version": "0.1.0",
  "private": true,
  "description": "ReelEstate: real-estate explainer videos (Remotion + Python pipeline) for Douyin / WeChat Channels",
  "scripts": {
    "new": "python pipeline/video.py new",
    "check": "python pipeline/video.py check",
    "check:taste": "python pipeline/common/taste.py",
    "render": "python pipeline/video.py render",
    "still": "python pipeline/video.py still",
    "setup": "python pipeline/video.py setup",
    "typecheck": "python pipeline/video.py typecheck",
    "flova:pool": "python scripts/flova/pool_panel.py",
    "episodes": "python pipeline/video.py episodes",
    "storage:audit": "python pipeline/video.py audit",
    "storage:compact": "python pipeline/video.py compact",
    "video:stage": "python pipeline/video.py stage",
    "restore": "python pipeline/video.py restore",
    "manifest": "python pipeline/video.py manifest",
    "video": "python pipeline/video.py",
    "doctor": "python pipeline/video.py doctor"
  },
  "engines": {
    "node": ">=20"
  }
}

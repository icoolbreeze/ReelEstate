# ---- 依赖 / 构建 ----
node_modules/
build/
dist/
out/
.remotion/
remotion/.cache/

# ---- 环境变量（真实路径/密钥，不提交）----
.env
.env.local

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---- 渲染输出（任意位置的 output/ 目录）----
output/

# ---- 房源项目：私有素材，默认全部忽略 ----
# 只保留 _example 示例项目和各分类目录的 .gitkeep
/projects/*
!/projects/_example/
!/projects/rental/
!/projects/resale/
!/projects/new-home/
/projects/rental/*
!/projects/rental/.gitkeep
/projects/resale/*
!/projects/resale/.gitkeep
/projects/new-home/*
!/projects/new-home/.gitkeep
# 即使在 _example 里，也不提交音视频
/projects/**/*.wav
/projects/**/*.mp3
/projects/**/*.mp4
/projects/**/*.mov
/projects/**/*.m4a

# ---- 声音克隆参考音频（私有，需本人书面授权）----
/voices/clone/*
!/voices/clone/.gitkeep
!/voices/clone/README.md

# ---- qwentts.cpp 构建产物（子模块自身 .gitignore 也忽略 build/）----
/vendor/qwentts.cpp/build/
/vendor/qwentts.cpp/models/*.gguf

# ---- 系统杂项 ----
.DS_Store
Thumbs.db
desktop.ini
*.log

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
